  function drawLegend(ctx, items, x, y, w) {
    const { g, S, th, fonts } = ctx;
    const fs = 21 * S, sw = 16 * S, gap = 26 * S, rowH = fs * 1.75;
    let cx = x, cy = y;
    items.forEach((it) => {

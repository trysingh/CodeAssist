async function deleteRepository(repoId) {
    if (!confirm(`Are you absolutely sure you want to remove ${repoId}? This will permanently delete all search indexes, raw file snapshots, and chat history for this repository. This cannot be undone.`)) return;

    try {
        const res = await fetch(`/api/v1/repos/${encodeURIComponent(repoId)}`, { method: 'DELETE' });
        if (!res.ok) throw new Error(`Server returned ${res.status}`);
        showToast("Repository removed", `Successfully removed ${repoId}`, "success");
        await loadRepositories();
    } catch (err) {
        showToast("Removal failed", err.message, "error");
    }
}


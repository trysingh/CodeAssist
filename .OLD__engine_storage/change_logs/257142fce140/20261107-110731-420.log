        if (!res.ok) throw new Error(`Server returned ${res.status}`);
        const html = await res.text();
        container.innerHTML = html;
        icons();
    } catch (err) {
        container.innerHTML = `<div class="py-20 text-center text-red-500">Failed to load documentation: ${err.message}</div>`;
